[default]
[private]
list:
    just --list --unsorted

# Delete all bytecode and cache files
clean:
    @find . -name "*.py[co]" -delete
    @find . -name "__pycache__" -type d -exec rm -rf {} +
    @find . -name ".*_cache" -type d -exec rm -rf {} +

# Lint and format all Python files
[group("hygiene")]
ruff:
    ruff format
    ruff check --fix

alias pyrefly := typecheck

# Type check all Python files
[group("hygiene")]
typecheck:
    pyrefly check .

# Validate hygiene of all Python files
[group("hygiene")]
validate:
    ruff format --check
    ruff check .
    @just typecheck

# Run the full test suite with coverage
[group("test")]
test *args:
    pytest --cov --cov-report=term-missing {{args}}

# Run specific tests with coverage
[group("test")]
test-one target *args:
    pytest --cov --cov-report=term-missing {{target}} {{args}}

# Run the test suite and write an HTML coverage report to htmlcov/
[group("test")]
coverage:
    pytest --cov --cov-report=html --cov-report=term
